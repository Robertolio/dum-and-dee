{
  "name": "dum-and-dee",
  "version": "0.1.0",
  "private": true,
  "description": "Dum & Dee — cooperative ladder-carrying web game (phase 1 prototype)",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm --filter @dd/client dev",
    "build": "pnpm --filter @dd/sim build && pnpm --filter @dd/client build",
    "preview": "pnpm --filter @dd/client preview",
    "test": "pnpm --filter @dd/sim test",
    "test:e2e": "pnpm --filter @dd/client test:e2e",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
